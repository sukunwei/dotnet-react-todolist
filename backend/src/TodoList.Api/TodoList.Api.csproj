<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 共用建置設定（框架版本、可空性、隱含 using、警告視為錯誤）
       定義於 backend/Directory.Build.props，此處不重複宣告。 -->

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <!-- EF Core 設計期工具套件。置於啟動專案（Api），dotnet ef 才能由啟動專案解析
         Microsoft.EntityFrameworkCore.Design；PrivateAssets=all 確保設計期組件
         不會進入發行輸出，也不會流向消費端。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TodoList.Application\TodoList.Application.csproj" />
    <ProjectReference Include="..\TodoList.Infrastructure\TodoList.Infrastructure.csproj" />
  </ItemGroup>

</Project>
