<Project Sdk="Microsoft.NET.Sdk">

  <!-- 共用建置設定（框架版本、可空性、隱含 using、警告視為錯誤）
       定義於 backend/Directory.Build.props，此處不重複宣告。 -->

  <ItemGroup>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- 明確指定 2.6.2，覆蓋 Pomelo 傳入的 2.4.0，並消除 NU1902 安全性警告 -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!-- EF Core 固定 9.0.23（計畫「框架版本」全域約束）。
         Design 套件移至啟動專案（Api），因其 PrivateAssets 不會流向消費端，
         而 Pomelo 傳入的是 9.0.0，導致 Infrastructure.dll（9.0.23）與 Api（9.0.0）
         版本衝突（MSB3277）並可能造成執行期 AssemblyLoadException。
         明確引用 Relational 9.0.23 可讓整個方案統一於 9.0.23。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TodoList.Domain\TodoList.Domain.csproj" />
  </ItemGroup>

</Project>
