<Project Sdk="Microsoft.NET.Sdk">

  <!-- 共用建置設定（框架版本、可空性、隱含 using、警告視為錯誤）
       定義於 backend/Directory.Build.props，此處不重複宣告。 -->

  <ItemGroup>
    <ProjectReference Include="..\TodoList.Domain\TodoList.Domain.csproj" />
  </ItemGroup>

  <!-- DI 註冊需要 IServiceCollection。Microsoft.Extensions.DependencyInjection.Abstractions
       只提供 DI 契約介面（IServiceCollection、ServiceDescriptor 等），不含任何實作、
       ORM 或 Web 框架，因此 Application 層仍不依賴 EF Core / MySQL / ASP.NET Core。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
